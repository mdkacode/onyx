# ============================================================================
# Azure targets for the SearXNG relay. Sourced by provision.sh / status.sh /
# teardown.sh. Every value can be overridden by exporting it beforehand.
# ============================================================================

# --- Where it lives (matches the existing prod VM so they share a VNet) ------
: "${SUBSCRIPTION_ID:=d091bc43-1a97-4a25-b271-a9eb6616bb82}"
: "${RESOURCE_GROUP:=naarni-cad-vm_group}"
: "${LOCATION:=centralindia}"
: "${VNET_NAME:=vnet-centralindia}"
: "${SUBNET_NAME:=snet-centralindia-1}"

# --- The Onyx VM that is allowed to call this instance -----------------------
: "${ONYX_VM_NAME:=naarni-ai-vm}"
: "${ONYX_VM_PRIVATE_IP:=172.16.0.5}"

# --- The SearXNG VM ----------------------------------------------------------
: "${SEARXNG_VM_NAME:=naarni-searxng-vm}"
# 2 vCPU / 1 GiB burstable. Same INR/hr as B1s but twice the CPU, and SearXNG
# is latency-bound on parallel outbound HTTP, so cores help more than RAM.
: "${SEARXNG_VM_SIZE:=Standard_B2ts_v2}"
: "${SEARXNG_PRIVATE_IP:=172.16.0.10}"
: "${SEARXNG_PORT:=8080}"
: "${ADMIN_USERNAME:=naarni}"
: "${OS_IMAGE:=Ubuntu2404}"
: "${OS_DISK_SIZE_GB:=30}"
: "${OS_DISK_SKU:=StandardSSD_LRS}"

# --- Derived names -----------------------------------------------------------
: "${NSG_NAME:=${SEARXNG_VM_NAME}-nsg}"
: "${NIC_NAME:=${SEARXNG_VM_NAME}-nic}"
: "${PUBLIC_IP_NAME:=${SEARXNG_VM_NAME}-pip}"
