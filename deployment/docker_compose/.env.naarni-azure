################################################################################
## NAARNI — Production Environment (Azure VM)
##
## SAFE TO COMMIT — no secrets in this file.
## All credentials are injected from GitHub Secrets at deploy time.
## See: .github/workflows/deploy-naarni-azure.yml
################################################################################

# Docker Hub image config
NAARNI_DOCKERHUB_ORG=naarnimd
IMAGE_TAG=latest

################################################################################
## AUTH — Microsoft 365 OIDC
################################################################################
AUTH_TYPE=oidc
# USER_AUTH_SECRET       → from GitHub secret
# OAUTH_CLIENT_ID        → from GitHub secret
# OAUTH_CLIENT_SECRET    → from GitHub secret
OPENID_CONFIG_URL=https://login.microsoftonline.com/f7ce75d0-d142-4734-a71c-466edb42a1dd/v2.0/.well-known/openid-configuration
OIDC_SCOPE_OVERRIDE=openid,email,profile,offline_access
OIDC_PKCE_ENABLED=true
VALID_EMAIL_DOMAINS=naarni.com,naarni.in
WEB_DOMAIN=https://ai.naarni.com

################################################################################
## DATABASE
################################################################################
POSTGRES_USER=postgres
# POSTGRES_PASSWORD      → from GitHub secret
POSTGRES_HOST=relational_db
REDIS_HOST=cache
VESPA_HOST=index

################################################################################
## FILE STORE — Azure Blob Storage (centralindia)
##
## Migrated off AWS S3 on 2026-08-11. Object keys are unchanged, so the
## `onyx-files/...` layout is identical to what the S3 bucket held; only the
## container (stored in file_record.bucket_name) differs.
##
## The old S3 bucket naarni-onyx-docs-533267308676-ap-south-1-an is retained
## as a cold copy — delete it only after this has run clean for a while.
################################################################################
COMPOSE_PROFILES=
FILE_STORE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_NAME=naarnionyxfilestore
AZURE_BLOB_CONTAINER_NAME=onyx-file-store
# AZURE_STORAGE_ACCOUNT_KEY → from GitHub secret

################################################################################
## GEN AI MODEL
################################################################################
GEN_AI_MODEL_VERSION=gpt-4.1-mini
GEN_AI_MAX_INPUT_TOKENS=1000000

################################################################################
## OPENSEARCH — Search backend (upstream replaced Vespa with OpenSearch).
## ONYX_DISABLE_VESPA defaults to true in the new code, so OpenSearch indexing
## MUST be enabled or the API crashes at startup (get_all_document_indices).
################################################################################
OPENSEARCH_FOR_ONYX_ENABLED=true
ENABLE_OPENSEARCH_INDEXING_FOR_ONYX=true

################################################################################
## CORS — Widget domains
################################################################################
CORS_ALLOWED_ORIGIN=https://naarni.com,https://www.naarni.com,https://ai.naarni.com

################################################################################
## SERVICES
################################################################################
MODEL_SERVER_HOST=inference_model_server
INDEXING_MODEL_SERVER_HOST=indexing_model_server
INTERNAL_URL=http://api_server:8080

################################################################################
## LOGGING & FEATURES
################################################################################
# Disable local model servers — using Azure OpenAI for embeddings
DISABLE_MODEL_SERVER=true

LOG_LEVEL=info
LOG_ONYX_MODEL_INTERACTIONS=False
REQUIRE_EMAIL_VERIFICATION=False
# Enables the Enterprise Edition menus/features (whitelabeling, query history,
# usage analytics, user groups, token rate-limits, etc.). These are Onyx EE
# features under the Onyx Enterprise License — using them in production is a
# licensing-compliance decision. LICENSE_ENFORCEMENT_ENABLED is left unset
# (default false), so this flag is the sole gate (no license key required).
#
# Set to False on 2026-06-05: after the upstream merge, EE-enabled + no license
# now forces application_status = GATED_ACCESS (ee/onyx/server/settings/api.py),
# showing the "Access Restricted / renew" wall to every user. OIDC login is
# registered in the base app (onyx/main.py), so it keeps working with EE off.
# Re-enable only with a valid Onyx Enterprise license.
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=False
VOICE_ENABLED=false

################################################################################
## NAARNI FLEET INTEGRATION
## Enables the Fleet Data chat tool + phone-based account linking.
## Device registration is automatic — no other config needed.
################################################################################
NAARNI_API_BASE_URL=https://api.naarni.com
